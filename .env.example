# AgriLens Environment Variables

# Server
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# Database (PostgreSQL - Replit Postgres / Supabase / Neon / Local)
# If left empty, an embedded zero-config database runs automatically in development
DATABASE_URL=
DATABASE_SSL=false

# Auth (HS256 JWT Secret, minimum 32 characters)
JWT_SECRET=agrilens_super_secure_jwt_secret_key_at_least_32_characters_long_2026
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Google Gemini (BACKEND ONLY, never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=45000

# Rate Limits & Quotas
MAX_UPLOAD_MB=8
MAX_IMAGES_PER_SCAN=4
DAILY_SCAN_LIMIT=20
DAILY_CHAT_LIMIT=60

# Dev & Demo
DEMO_PASSWORD=DemoPassword123!

# Client (Vite)
VITE_API_URL=/api/v1
